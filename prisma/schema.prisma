generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  templates   Template[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id              String   @id @default(cuid())
  name            String
  description     String
  layout          String   // 'strip' | 'grid2x2' | 'single' | 'strip3' | 'grid2x3' | 'grid2x4'
  photoCount      Int
  thumbnail       String?
  frameColor      String
  backgroundColor String
  textColor       String
  accentColor     String
  fonts           String
  hasLogo         Boolean  @default(true)
  hasDate         Boolean  @default(true)
  hasFrame        Boolean  @default(true)
  frameWidth      Int      @default(20)
  aspectRatio     String   @default("1:3")
  overlayImage    String?
  slotsJson       String?
  categoryId      String?
  category        TemplateCategory? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventConfig {
  id                  String   @id @default(cuid())
  eventName           String   @default("My Event")
  startDate           DateTime
  endDate             DateTime
  quota               Int      @default(0) // 0 means unlimited
  usedQuota           Int      @default(0)
  userSessionDuration Int      @default(300)
  page1Duration       Int      @default(30)
  page2Duration       Int      @default(180)
  page3Duration       Int      @default(60)
  photoCountdown      Int      @default(5)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id          String    @id @default(uuid())
  userName    String?
  sessionName String?
  sessionCode String?   @unique
  gridType    String?   // 'grid2x3' | 'grid2x4' dsb
  startTime   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime? // Waktu jika sesi diakhiri manual/selesai sebelum batas
  isActive    Boolean   @default(true)
  status      String    @default("ACTIVE") // PENDING, ACTIVE, FINISHED, CANCELLED
  lastPingAt  DateTime  @default(now())
}
