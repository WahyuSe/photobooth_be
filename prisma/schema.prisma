generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id              String   @id @default(cuid())
  name            String
  description     String
  layout          String   // 'strip' | 'grid2x2' | 'single' | 'strip3'
  photoCount      Int
  thumbnail       String?
  frameColor      String
  backgroundColor String
  textColor       String
  accentColor     String
  fonts           String
  hasLogo         Boolean  @default(true)
  hasDate         Boolean  @default(true)
  hasFrame        Boolean  @default(true)
  frameWidth      Int      @default(20)
  aspectRatio     String   @default("1:3")
  overlayImage    String?
  slotsJson       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id          String    @id @default(uuid())
  userName    String?
  sessionName String?
  sessionCode String?   @unique
  startTime   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime? // Waktu jika sesi diakhiri manual/selesai sebelum batas
  isActive    Boolean   @default(true)
  status      String    @default("ACTIVE") // PENDING, ACTIVE, FINISHED, CANCELLED
  lastPingAt  DateTime  @default(now())
}
